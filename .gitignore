# ==============================================================================
# Git Ignore - Full-Stack AI App (Flutter App + Node.js Backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Environment Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.history/

# ------------------------------------------------------------------------------
# Logs & Process PID files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# Secrets, Environment & Sensitive Files
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt
id_rsa
id_rsa.pub

# ------------------------------------------------------------------------------
# Node.js & Backend
# ------------------------------------------------------------------------------
**/node_modules/
backend/node_modules/
.npm
.eslintcache
.node_repl_history
package-lock.json.bak
*.sqlite
*.sqlite3
*.db
backend/*.db
backend/*.sqlite

# ------------------------------------------------------------------------------
# Flutter / Dart Specific
# ------------------------------------------------------------------------------
**/build/
ai_assistant/build/
.dart_tool/
ai_assistant/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
ai_assistant/.pub-cache/
ai_assistant/.pub/
**/doc/api/
coverage/

# Obfuscation & Symbols
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Android (Flutter App)
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/gradleBuild/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/local.properties
**/android/key.properties
**/android/**/*.keystore
**/android/**/*.jks
*.apk
*.aab

# ------------------------------------------------------------------------------
# iOS (Flutter App)
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/*-Info.plist

# ------------------------------------------------------------------------------
# Temporary Scripts & Diagnostic Outputs
# ------------------------------------------------------------------------------
scratch/
temp/
tmp/
*.tmp
*.bak
*.swp
*.pyc
__pycache__/

