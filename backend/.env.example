# Simhastha Backend Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration (for Node.js server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=simhastha_db

# ngrok Configuration (Optional - for testing)
# When using ngrok, your public URL will be: https://xxxx.ngrok-free.app
# No need to set it here - ngrok generates it dynamically

# CORS Settings (Optional)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
